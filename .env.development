# Paigon game builds for LOCAL DEVELOPMENT. Read by `npm run dev` and
# `npm run build:dev` in every game.
#
# Points at a game server on this machine and the local Firebase emulators, so
# nothing you do in development can touch real accounts or data. Start both
# from the repo root with:   npm run dev:stack
# (see docs/ENVIRONMENTS.md). The "demo-" project id is a Firebase convention:
# the SDKs refuse to contact any real project for it.
#
# When a hosted development environment exists (its own Firebase project and
# Railway service), a .env.staging with its values goes alongside this file.
VITE_PAIGON_ENV=development
VITE_SERVER_URL=http://localhost:3100
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-paigon.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-paigon
VITE_FIREBASE_STORAGE_BUCKET=demo-paigon.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=0
VITE_FIREBASE_APP_ID=demo-app
VITE_ENABLE_REAL_MONEY=true
VITE_USE_EMULATORS=true
# Stripe TEST-mode publishable key (pk_test_…), for the development deposit
# flow only. Publishable keys are designed to be public; secret keys never go
# in any VITE_ variable.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51Tj0P6KucA1LYHuIKPYkDXGhhu51NXIMiYGZJF2nmOLcEC2SxXuWwsBURJ0d8MVwQL81gC3ykw7JzcUVwjFRBtZd00G3oesKnp
