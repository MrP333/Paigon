# Paigon game builds for PRODUCTION (paigonco.com). Read by every game's
# `npm run build`. These values are public by design: a Firebase web config
# identifies a project, it does not grant access (the security rules do), and
# the server URL is public. NEVER put a secret in a VITE_ variable — anything
# prefixed VITE_ is compiled into the JavaScript every visitor downloads.
VITE_PAIGON_ENV=production
VITE_SERVER_URL=https://mazergame11-production.up.railway.app
VITE_FIREBASE_API_KEY=AIzaSyAIEYryVjB1gX2bzXWERNI0udfjHXuXwzc
VITE_FIREBASE_AUTH_DOMAIN=paigonco.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=paigonco
VITE_FIREBASE_STORAGE_BUCKET=paigonco.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=879434208536
VITE_FIREBASE_APP_ID=1:879434208536:web:5ff633fc0534c3f1d73a6d
# Money UI. The server refuses paid play in production regardless.
VITE_ENABLE_REAL_MONEY=false
VITE_USE_EMULATORS=false
